---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Licence from "../../components/Licence.astro";
import { topics } from "../../content.config";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const updated = entry.data.updated.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base title={entry.data.title} description={entry.data.description}>
  <p class="meta"><a href="/guides/">Guides</a> / {topics[entry.data.topic]}</p>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="meta">Updated {updated}</p>
    <Content />
  </article>
  {entry.data.drafted && <p class="meta">Drafted by Claude ({entry.data.drafted}), edited by River James.</p>}
  <Licence title={entry.data.title} />
</Base>
