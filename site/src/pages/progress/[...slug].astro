---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Licence from "../../components/Licence.astro";

export async function getStaticPaths() {
  const posts = await getCollection("progress", (p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const when = entry.data.date.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p class="meta"><a href="/progress/">Progress</a></p>
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="meta"><time datetime={entry.data.date.toISOString().slice(0, 10)}>{when}</time></p>
    <Content />
  </article>
  {entry.data.drafted && <p class="meta">Drafted by Claude ({entry.data.drafted}), edited by River James.</p>}
  <Licence title={entry.data.title} />
</Base>
