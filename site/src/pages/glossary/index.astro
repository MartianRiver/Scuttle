---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const terms = (await getCollection("glossary")).sort((a, b) => a.data.term.localeCompare(b.data.term));
---
<Base title="Glossary" description="Short plain-words explanations of the words used in the Scuttle guides.">
  <h1>Glossary</h1>
  <p class="lede">Every word the guides lean on, explained in a sentence or two. In a guide, a word with a dotted underline opens its explanation in a small box: tap it, or tab to it and press Enter. Escape or a tap outside closes it, and "Read more" comes to this page. If the box doesn't open, the word is a plain link to its entry here.</p>
  <dl class="glossary">
    {terms.map((t) => (
      <>
        <dt><a href={`/glossary/${t.id}/`}>{t.data.term}</a></dt>
        <dd>{t.data.short}</dd>
      </>
    ))}
  </dl>
</Base>
