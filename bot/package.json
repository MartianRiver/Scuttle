{
  "name": "scuttlemc-bot",
  "version": "0.1.0",
  "description": "Mineflayer body for Scuttle: a bounded, LLM-drivable Minecraft bot",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-26.2.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mineflayer": "^4.38.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "rcon-client": "^4.2.5",
    "winston": "^3.13.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
