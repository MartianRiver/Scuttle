# Minecraft server the bot joins (Java edition)
MC_HOST=localhost
MC_PORT=25565

# microsoft: log in with a purchased Java account, using its Microsoft account email as the username
# (device-code flow, no password stored). offline: any name, only for a local offline-mode server.
MC_USERNAME=
MC_AUTH=microsoft

# leave unset: the bot is patched for 26.3 only and refuses any other value
MC_VERSION=

# RCON to the server running the Scuttle plugin: how the bot pushes its task and location to
# chat-Scuttle. Optional: left unset, the bot runs without reporting status and guard duty stays off.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=

# body control API (API.md). Off unless both are set. Binds localhost; reach it by tunnel.
# API_TOKENS=label:token,label2:token2  — tokens 24+ chars, e.g. `openssl rand -hex 24`
API_HOST=127.0.0.1
API_PORT=
API_TOKENS=
